# --- MongoDB (Atlas free cluster) ---
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/bazardor

# --- Better Auth ---
# generate with: npx @better-auth/cli secret   (or: openssl rand -base64 32)
BETTER_AUTH_SECRET=
# local: http://localhost:3000   |   deployed: https://your-app.vercel.app
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Social login (optional but required by the assignment) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Product API (optional override) ---
NEXT_PUBLIC_API_BASE=https://api.api-store.workers.dev/api/bazardor
